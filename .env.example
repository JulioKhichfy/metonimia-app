# Copie para .env no servidor (cp .env.example .env) e preencha. NUNCA suba o .env para o GitHub.

# Domínio principal em punycode (metonímia.com.br = xn--metonmia-g2a.com.br)
DOMAIN=xn--metonmia-g2a.com.br
# Domínios que redirecionam para o principal, separados por vírgula e espaço.
# Se registrar a versão sem acento, use:
# REDIRECT_DOMAINS=www.xn--metonmia-g2a.com.br, metonimia.com.br, www.metonimia.com.br
REDIRECT_DOMAINS=www.xn--metonmia-g2a.com.br

# Contato exibido no site (rodapé, Fale Conosco, WhatsApp) e destino do formulário (FormSubmit).
# Depois de mudar, rode ./deploy/atualizar.sh para reconstruir o site.
CONTATO_EMAIL=assessoria@metonimia.com.br
CONTATO_WHATSAPP="+55 21 99896-1769"

# E-mail para mensagens aos intérpretes (SMTP do provedor do e-mail assessoria@metonimia.com.br).
# Deixe MAIL_HOST vazio enquanto não tiver o e-mail: o painel continua gerando os links de WhatsApp.
# Ex.: Google Workspace: smtp.gmail.com / 587 (senha de app) · Zoho: smtp.zoho.com / 587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=assessoria@metonimia.com.br
MAIL_PASSWORD=
MAIL_REMETENTE=assessoria@metonimia.com.br
# Recebe uma cópia de toda mensagem enviada aos intérpretes
MENSAGEM_COPIA_EMAIL=assessoria@metonimia.com.br

# Banco
DB_USERNAME=metonimia
DB_PASSWORD=troque-por-uma-senha-longa

# Chave do login (gere com: openssl rand -base64 48)
APP_JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Administrador criado na primeira inicialização
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
