# =============================================================================
#  SOMENTE PARA TESTES LOCAIS (Docker no seu PC / WSL). NUNCA use em produção.
#
#  Uso:  cp .env.local .env   e depois   docker compose up -d --build
#  Site: https://localhost (aceite o aviso de certificado) · Painel: /admin
#
#  Os valores abaixo são públicos (estão no GitHub) e por isso não são segredo:
#  servem só para o ambiente subir. Na VPS, o .env é gerado pelo
#  deploy/preparar-servidor.sh com senhas aleatórias.
# =============================================================================

DOMAIN=localhost
REDIRECT_DOMAINS=www.localhost

CONTATO_EMAIL=assessoria@metonimia.com.br
CONTATO_WHATSAPP="+55 21 99896-1769"

# E-mail desligado no teste local (o painel avisa e gera os links de WhatsApp)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=assessoria@metonimia.com.br
MENSAGEM_COPIA_EMAIL=assessoria@metonimia.com.br

DB_USERNAME=metonimia
DB_PASSWORD=senha-local-de-teste
APP_JWT_SECRET=chave-local-de-teste-com-mais-de-32-caracteres-nao-use-em-producao

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
